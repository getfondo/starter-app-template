{
  "name": "@fondo/starter-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.11" },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "setup": "bash scripts/setup.sh",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "db:generate": "drizzle-kit generate --name init",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "test": "vitest run",
    "start": "node --import ./dist/server/telemetry.js dist/server/main.js"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.0.0",
    "@microsoft/opentelemetry": "^1.5.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.0",
    "jose": "^6.0.0",
    "keycloak-js": "^26.2.0",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
