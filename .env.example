# Local defaults match docker-compose.yml. npm run setup fills .env.local from the Dev Container App.
DATABASE_URL=postgres://app:app@localhost:5432/app
KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_JWKS_URL=              # optional internal URL for key fetches; defaults to KEYCLOAK_URL
STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_CONTAINER=uploads
APPLICATIONINSIGHTS_CONNECTION_STRING=
# local only; in Azure the app listens on 8080 and signs in to Postgres with its identity (PG_AUTH=entra)
# Local Keycloak already uses 8080, so local dev keeps the API on 3000.
PORT=3000
LOG_LEVEL=info
# When set, only requests carrying a matching X-Azure-FDID header are served (Azure Front Door ID).
FRONTDOOR_ID=
